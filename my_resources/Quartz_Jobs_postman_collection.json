              "raw": "{\n  \"jobName\":    \"EmailCada6Horas\",\n  \"jobGroup\":   \"EMAIL\",\n  \"jobClass\":   \"com.quartzjobs.jobs.EmailJob\",\n  \"intervalMs\": 21600000,\n  \"data\": {\n    \"to\":      \"monitoreo@empresa.com\",\n    \"subject\": \"Chequeo de sistema\",\n    \"body\":    \"El sistema está funcionando correctamente.\"\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
