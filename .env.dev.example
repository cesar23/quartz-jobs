# ============================================================
#  Quartz Jobs — plantilla de variables de entorno
#  Copia este fichero como ".env.dev" (o expórtalas en tu shell/CI)
#  y completa con tus propios valores. NUNCA subas el ".env.dev" real
#  a un repositorio.
# ============================================================

COMPOSE_PROJECT_NAME=jobs-dev


# =========================================================================
# APP
# =========================================================================
# version de compilacion de la app
APP_VERSION_BUILT=v1.0.2
# arancar  tablas (always=creatablas, never= ya no las  crea)
QUARTZ_INIT_SCHEMA=never
# token para  obtener los logs

# --- Docker / MariaDB -------------------------------------------
_TZ=America/Lima
MARIADB_ROOT_PASSWORD=cesar203



# --- Perfil activo -------------------------------------------
SPRING_PROFILES_ACTIVE=dev

# --- Servidor --------------------------------------------------
# [Sin Docker] SERVER_PORT: puerto real de Spring Boot cuando corres SIN Docker.
# Dentro de Docker se ignora -- el contenedor siempre usa 8080 fijo.
SERVER_PORT=8080
# [Con Docker] HOST_PORT: puerto que ves TU desde fuera del contenedor con Dockecompose
HOST_PORT=8080

# --- Base de datos (perfil "prod" / MySQL) ---------------------
DB_HOST=mariadb
DB_PORT=3306
DB_NAME=quartzjobs_dev
DB_USERNAME=quartzjobs_dev
DB_PASSWORD=cesar203


# =========================================================================
# phpMyAdmin
# =========================================================================
PHPMYADMIN_VERSION=5.2.3
# Solo accesible desde localhost en pre producci�n
HOST_MACHINE_PMA_PORT=19091
UPLOAD_LIMIT=512M
MEMORY_LIMIT=512M
MAX_EXECUTION_TIME=600

# --- Correo (SMTP) ----------------------------------------------
# Si usas Gmail, genera una "contraseña de aplicación" dedicada:
# https://myaccount.google.com/apppasswords
# NUNCA uses tu contraseña normal de la cuenta.
#MAIL_HOST=smtp.gmail.com
#MAIL_PORT=587
#MAIL_USERNAME=notificacion.web.mail@gmail.com
#MAIL_PASSWORD="vmgyhkjkpfkdkszj"

MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=465
MAIL_USERNAME=8a0b6386b88931
MAIL_PASSWORD="747a74bc24761a"

# token para  obtener los logs
INTERNAL_API_TOKEN=un-valor-largo-y-random-que-generes-tu


# --- Logging ------------------------------------------------------
LOG_LEVEL=INFO

