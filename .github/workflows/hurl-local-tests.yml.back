name: API Tests - Full Suite

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

jobs:
  api-tests:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Start services
        run: docker compose up -d --wait

      - name: Install Hurl
        run: |
          curl -LO https://github.com/Orange-OpenSource/hurl/releases/latest/download/hurl_linux_amd64.tar.gz
          tar -xzf hurl_linux_amd64.tar.gz
          sudo mv hurl /usr/local/bin/

      - name: Wait for app healthcheck
        run: |
          for i in {1..30}; do
            curl -sf http://localhost:8080/api/v1/actuator/health && break
            echo "Intento $i/30..."
            sleep 5
          done

      # Construye local.env desde secrets de GitHub
      - name: Build local.env
        run: |
          cat <<EOF > hurl/envs/local.env
          base_url=http://localhost:8080/api/v1
          admin_user=${{ secrets.LOCAL_ADMIN_USER }}
          admin_pass=${{ secrets.LOCAL_ADMIN_PASS }}
          EOF

      - name: Run full test suite
        env:
          HURL_ENV: local
        run: bash hurl/scripts/run-ci.sh

      - name: Publish test results
        uses: dorny/test-reporter@v1
        if: always()
        with:
          name: Hurl Full Suite
          path: target/hurl-junit.xml
          reporter: java-junit

      - name: Upload HTML report
        uses: actions/upload-artifact@v4
        if: always()
        with:
          name: hurl-report-full
          path: target/hurl-report/
